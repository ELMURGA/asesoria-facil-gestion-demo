{
  "cleanUrls": false,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] }
  ],
  "rewrites": [
    { "source": "/docs/:path*", "destination": "/404.html" },
    { "source": "/tests/:path*", "destination": "/404.html" },
    { "source": "/capturas/:path*", "destination": "/404.html" },
    { "source": "/PRODUCT.md", "destination": "/404.html" },
    { "source": "/README.md", "destination": "/404.html" }
  ]
}
