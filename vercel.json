{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/docs/:path*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/tests/:path*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/capturas/:path*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/PRODUCT.md",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/README.md",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/vercel.json",
      "destination": "/404.html",
      "permanent": false
    }
  ]
}